---
// ============================================================
//  SiteFooter — shared across the site.
//  Links are grouped by what a visitor would use them for, each
//  with a short hint. The Newsletter entry stays commented out
//  until the Buttondown feature is re-enabled
//  (see functions/api/subscribe.ts).
// ============================================================

const year = new Date().getFullYear();

const GROUPS = [
  {
    title: 'Get in touch',
    links: [
      { href: 'mailto:contact@preahs.com', label: 'Email', hint: 'contact@preahs.com' },
      {
        href: 'https://signal.me/#eu/7FQaEphPdhSrlUCPuqr8awsHVYUSiJ9CGua_YktOEMge3oIT-itMcKuS2r3k6x8Q',
        label: 'Signal',
        hint: 'message me privately',
      },
      {
        href: 'https://matrix.to/#/@preshavocado:snowberry.social',
        label: 'Matrix',
        hint: '@preshavocado on snowberry.social',
      },
    ],
  },
  {
    title: 'Follow along',
    links: [
      { href: '/rss.xml', label: 'RSS', hint: 'new posts in your feed reader' },
      // { href: '/subscribe', label: 'Newsletter', hint: 'new posts by email' },
    ],
  },
  {
    title: 'Code',
    links: [
      { href: 'https://git.preahs.com/preah', label: 'Forgejo', hint: 'my self-hosted git repos' },
    ],
  },
];
---

<footer class="site-foot">
  <div class="foot-grid">
    <div class="foot-about">
      <span class="foot-brand">Preah</span>
      <p>
        Thanks for reading. Questions, corrections, or just want to say
        hi? Reach out on whichever channel suits you.
      </p>
    </div>
    {GROUPS.map((group) => (
      <div class="foot-group">
        <h2>{group.title}</h2>
        <ul>
          {group.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
              <span class="foot-hint">{link.hint}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="foot-base">
    <span>&copy; {year} Preah</span>
    <span class="foot-dot">&middot;</span>
    <a href="#top">back to top &uarr;</a>
  </div>
</footer>
