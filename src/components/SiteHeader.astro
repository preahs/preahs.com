---
// ============================================================
//  SiteHeader — brand mark + top nav, shared across the site.
// ============================================================

interface Props {
  /** Which nav link to mark as current, e.g. "blog". */
  active?: string;
}

const { active } = Astro.props;

const NAV = [
  { href: '/', label: 'home', key: 'home' },
  { href: '/blog', label: 'blog', key: 'blog' },
  { href: '/docs', label: 'docs', key: 'docs' },
  { href: '/homelab', label: 'homelab', key: 'homelab' },
  { href: '/portfolio', label: 'portfolio', key: 'portfolio' },
  { href: '/about', label: 'about', key: 'about' },
];
---

<header class="site-head">
  <div class="brand-row">
    <span class="brand-icon" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.0" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 1 1 1 0 8h-1"/><path d="M6 2v2"/></svg>
    </span>
    <a class="brand" href="/">Preah</a>
  </div>
  <nav class="nav">
    {NAV.map((item) => (
      <a
        href={item.href}
        class={active === item.key ? 'active' : undefined}
        aria-current={active === item.key ? 'page' : undefined}
      >{item.label}</a>
    ))}
  </nav>
</header>
