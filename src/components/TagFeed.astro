---
// ============================================================
//  TagFeed — the tag-filtered listing shared by /blog and /docs.
//
//  Every entry is rendered into the HTML at build time. The tag
//  filter is a progressive enhancement layered on top: it shows
//  and hides entries that are already on the page rather than
//  building the list from a JSON blob at runtime. Without JS the
//  full list still renders, so the markup carries real, crawlable
//  links to every post.
// ============================================================

export interface FeedEntry {
  title: string;
  desc: string;
  tags: string[];
  date: string;
  read: string;
  href: string;
}

interface Props {
  entries: FeedEntry[];
  /** Tag rail order, already sorted by the caller. */
  tags: string[];
  intro: string;
  /** Singular/plural noun for the entries, e.g. "post" / "posts". */
  noun: string;
  nounPlural: string;
}

const { entries, tags, intro, noun, nounPlural } = Astro.props;

const tagCounts = new Map<string, number>(
  tags.map((t) => [t, entries.filter((e) => e.tags.includes(t)).length])
);

// Tags are matched as "|tag|" against this string, so a tag can never
// match as a substring of a longer one (e.g. "tech" vs "tech-notes").
const tagAttr = (entryTags: string[]) => `|${entryTags.join('|')}|`;
---

<div class="landing">
  <!-- LEFT RAIL: tag filter (enhancement; hidden when JS is off) -->
  <aside>
    <div class="tag-box">
      <div class="tag-box-label">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2H2v10l9.29 9.29a1 1 0 0 0 1.41 0l7.3-7.3a1 1 0 0 0 0-1.41L12 2Z"/><circle cx="7" cy="7" r="1" fill="currentColor"/></svg>
        Filter by tag
      </div>
      <ul class="tag-list">
        <li>
          <button class="tag-item selected" data-tag="" aria-pressed="true">
            All {nounPlural}
          </button>
        </li>
        {tags.map((tag) => (
          <li>
            <button class="tag-item" data-tag={tag} aria-pressed="false">
              {tag}<span class="tag-count">{tagCounts.get(tag)}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <!-- RIGHT COLUMN: previews, all rendered at build time -->
  <main>
    <div class="feed-intro">
      <p>{intro}</p>
    </div>
    <div class="feed-here" id="here" aria-live="polite">
      Showing <b>most recent</b> {nounPlural}
    </div>

    <div id="previews">
      {entries.map((e) => (
        <article class="preview" data-tags={tagAttr(e.tags)}>
          <a class="title" href={e.href}>{e.title}</a>
          <p class="desc">{e.desc}</p>
          <div class="meta">
            <span class="mi" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
            </span>
            <span>{e.date}</span>
            <span class="gap"></span>
            <span class="mi" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </span>
            <span>{e.read}</span>
          </div>
          <div class="preview-tags">
            {e.tags.map((t) => (
              <button class="preview-tag" data-tag={t}>{t}</button>
            ))}
          </div>
        </article>
      ))}
    </div>

    <p class="empty" id="empty" hidden>No {nounPlural} with this tag yet.</p>
  </main>
</div>

<noscript>
  <style>
    /* The tag filter needs JS; the listing itself does not. */
    .tag-box, .feed-here { display: none; }
    .landing { grid-template-columns: 1fr; }
    .preview-tag { cursor: default; }
  </style>
</noscript>

<script is:inline define:vars={{ NOUN: noun, NOUN_PLURAL: nounPlural }}>
  (function () {
    var articles = Array.prototype.slice.call(
      document.querySelectorAll('#previews .preview')
    );
    var tagButtons = Array.prototype.slice.call(
      document.querySelectorAll('.tag-item')
    );
    var here = document.getElementById('here');
    var empty = document.getElementById('empty');

    var KNOWN = tagButtons
      .map(function (b) { return b.getAttribute('data-tag'); })
      .filter(Boolean);

    var selected = null; // null = show everything

    function setHere(count) {
      if (selected === null) {
        here.textContent = '';
        here.appendChild(document.createTextNode('Showing '));
        var strong = document.createElement('b');
        strong.textContent = 'most recent';
        here.appendChild(strong);
        here.appendChild(document.createTextNode(' ' + NOUN_PLURAL));
        return;
      }
      here.textContent = '';
      here.appendChild(document.createTextNode('Tagged '));
      var b = document.createElement('b');
      b.textContent = selected;
      here.appendChild(b);
      here.appendChild(
        document.createTextNode(
          ' · ' + count + ' ' + (count === 1 ? NOUN : NOUN_PLURAL)
        )
      );
    }

    function apply() {
      var lastVisible = null;

      articles.forEach(function (article) {
        var match =
          selected === null ||
          article.getAttribute('data-tags').indexOf('|' + selected + '|') > -1;
        article.hidden = !match;
        article.classList.remove('is-last');
        if (match) lastVisible = article;
      });

      var count = articles.filter(function (a) { return !a.hidden; }).length;
      if (lastVisible) lastVisible.classList.add('is-last');

      empty.hidden = count !== 0;
      setHere(count);

      tagButtons.forEach(function (btn) {
        var tag = btn.getAttribute('data-tag') || null;
        var isSelected = tag === selected;
        btn.classList.toggle('selected', isSelected);
        btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });

      var url = new URL(window.location.href);
      if (selected) {
        url.searchParams.set('tag', selected);
      } else {
        url.searchParams.delete('tag');
      }
      history.replaceState(null, '', url.toString());
    }

    function choose(tag) {
      selected = selected === tag ? null : tag;
      apply();
    }

    tagButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        choose(btn.getAttribute('data-tag') || null);
      });
    });

    document.querySelectorAll('.preview-tag').forEach(function (btn) {
      btn.addEventListener('click', function () {
        choose(btn.getAttribute('data-tag'));
      });
    });

    // Honour ?tag= on load, but only for tags that actually exist.
    var param = new URLSearchParams(window.location.search).get('tag');
    if (param && KNOWN.indexOf(param) > -1) selected = param;

    apply();
  })();
</script>

<style is:global>
  .landing {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2.5rem;
    align-items: start;
    padding-bottom: 3rem;
  }
  @media (max-width: 760px) {
    .landing { grid-template-columns: 1fr; gap: 1.75rem; }
  }

  /* ---- feed intro ---- */
  .feed-intro p { color: var(--ink); font-size: 1.1rem; margin-bottom: 0.6rem; }
  .feed-here {
    font-family: var(--font-mono); font-size: 0.78rem;
    color: var(--ink-faint); margin-bottom: 1.4rem;
  }
  .feed-here b { color: var(--accent); font-weight: 500; }
  .empty { color: var(--ink-faint); font-style: italic; padding: 1rem 0; }

  /* ---- tag filter box ---- */
  .tag-box {
    border: 1.5px solid var(--rule);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    background: var(--paper-card);
  }

  .tag-box-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin-bottom: 0.85rem;
  }
  .tag-box-label svg { width: 1rem; height: 1rem; flex: none; }

  .tag-list { list-style: none; display: flex; flex-direction: column; gap: 0.2rem; }

  .tag-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.3rem 0.5rem;
    border-radius: 5px;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-body, inherit);
    font-size: 0.97rem;
    color: var(--accent);
    text-align: left;
    transition: background 0.13s;
    user-select: none;
  }
  .tag-item:hover { background: var(--accent-soft); }
  .tag-item.selected { background: var(--accent-soft); font-weight: 500; text-decoration: underline; text-underline-offset: 3px; }

  .tag-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
    margin-left: 0.35rem;
    flex: none;
  }

  /* ---- preview cards ---- */
  .preview {
    border-bottom: 1.5px dashed var(--rule);
    padding-bottom: 1.4rem;
    margin-bottom: 1.4rem;
  }
  /* `.is-last` tracks the last *visible* card while a tag filter is on. */
  .preview:last-child, .preview.is-last { border-bottom: none; }
  .preview[hidden] { display: none; }

  .preview .title {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 0.3rem;
    line-height: 1.25;
  }
  .preview .title:hover { color: var(--accent); }

  .preview .desc {
    font-size: 0.97rem;
    color: var(--ink-soft);
    margin-bottom: 0.55rem;
    line-height: 1.5;
  }

  .preview .meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-bottom: 0.55rem;
  }
  .preview .meta .mi { display: flex; width: 1rem; flex: none; }
  .preview .meta .mi svg { width: 1rem; height: 1rem; }
  .preview .meta .gap { flex: none; width: 0.6rem; }

  .preview-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .preview-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    padding: 0.1em 0.55em;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: #FEFCF6;
    cursor: pointer;
    transition: border-color 0.13s, background 0.13s;
  }
  .preview-tag:hover { border-color: var(--accent); background: var(--accent-soft); }
</style>
