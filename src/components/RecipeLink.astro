---
// ============================================================
//  RecipeLink — rounded recipe "card pill": kind icon in an
//  accent-soft disc, recipe title, and a small mono sub-line.
// ============================================================

import type { RecipeKind } from '../lib/recipes';

interface Props {
  title: string;
  url: string;
  kind: RecipeKind;
  /** Small mono line under the title, e.g. the source site. */
  sub: string;
}

const { title, url, kind, sub } = Astro.props;

// Lucide-style outline icons, one per recipe kind.
const ICON: Record<RecipeKind, string> = {
  main: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  soup: '<path d="M12 21a9 9 0 0 0 9-9H3a9 9 0 0 0 9 9Z"/><path d="M7 21h10"/><path d="M19.5 12 22 6"/><path d="M16.25 3c.27.1.8.53.75 1.36-.06.83-.93 1.2-1 2.02-.05.78.34 1.24.73 1.62"/><path d="M11.25 3c.27.1.8.53.74 1.36-.05.83-.93 1.2-.98 2.02-.06.78.33 1.24.72 1.62"/><path d="M6.25 3c.27.1.8.53.75 1.36-.06.83-.93 1.2-1 2.02-.05.78.34 1.24.74 1.62"/>',
  salad: '<path d="M7 21h10"/><path d="M12 21a9 9 0 0 0 9-9H3a9 9 0 0 0 9 9Z"/><path d="M11.38 12a2.4 2.4 0 0 1-.4-4.77 2.4 2.4 0 0 1 3.2-2.77 2.4 2.4 0 0 1 3.47-.63 2.4 2.4 0 0 1 3.37 3.37 2.4 2.4 0 0 1-1.1 3.7 2.51 2.51 0 0 1 .03 1.1"/><path d="m13 12 4-4"/><path d="M10.9 7.25A3.99 3.99 0 0 0 4 10c0 .73.2 1.41.54 2"/>',
  drink: '<path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/>',
  dessert: '<circle cx="9" cy="7" r="2"/><path d="M7.2 7.9 3 11v9c0 .6.4 1 1 1h16c.6 0 1-.4 1-1v-9c0-2-3-6-7-8l-3.6 2.6"/><path d="M16 13H3"/><path d="M16 17H3"/>',
};
---

<a class="recipe" href={url} target="_blank" rel="noopener noreferrer">
  <span class="ic" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON[kind]}></svg>
  </span>
  <span class="txt">
    <span class="t">{title}</span>
    <span class="d">{sub} <span aria-hidden="true">&#8599;</span></span>
  </span>
</a>

<style>
  .recipe {
    display: inline-flex; align-items: center; gap: 0.7rem;
    max-width: 100%; padding: 0.55rem 1.1rem 0.55rem 0.6rem;
    text-decoration: none; color: var(--accent);
    background: var(--paper-card);
    border: 1.5px solid var(--rule-strong); border-radius: 1.6rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .recipe:hover { border-color: var(--accent); background: var(--accent-soft); }
  .ic {
    flex: none; width: 2rem; height: 2rem; border-radius: 50%;
    background: var(--accent-soft); color: var(--accent);
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .recipe:hover .ic { background: var(--paper-card); }
  .ic svg { width: 1.05rem; height: 1.05rem; display: block; }
  .txt { display: flex; flex-direction: column; min-width: 0; }
  .t {
    font-family: var(--font-display); font-weight: 500; font-size: 1.05rem;
    line-height: 1.2; letter-spacing: -0.01em; color: var(--ink);
  }
  .d {
    font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.5;
    color: var(--ink-faint);
  }
</style>
