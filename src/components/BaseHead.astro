---
// ============================================================
//  BaseHead — the shared <head> for every page on the site.
//  Anything that belongs on all pages (meta, favicons, fonts,
//  social cards) lives here; page-specific <link>/<meta> go in
//  the slot.
// ============================================================

import { ogPathFor } from '../lib/og';

interface Props {
  /** Page name, composed as "{title} — Preah". */
  title: string;
  description: string;
  /** Replaces the composed title outright (used by the home page). */
  fullTitle?: string;
  /** Adds the RSS <link rel="alternate">. */
  rss?: boolean;
  /** "article" for blog posts and docs; "website" everywhere else. */
  ogType?: 'website' | 'article';
}

const { title, description, fullTitle, rss = false, ogType = 'website' } = Astro.props;
const pageTitle = fullTitle ?? `${title} — Preah`;
// Previews carry og:site_name separately, so the card title drops the
// " — Preah" suffix that the browser tab title needs.
const socialTitle = fullTitle ?? title;
const imageAlt = `${socialTitle} — preahs.com`;

// Trailing slash kept consistent so the canonical URL and the og:url
// always agree, whichever way a visitor arrived.
const path = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const canonical = new URL(path, Astro.site).href;
// Built by src/pages/og/[...route].png.ts at build time.
const ogImage = new URL(ogPathFor(Astro.url.pathname), Astro.site).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
{rss && <link rel="alternate" type="application/rss+xml" title="Preah's Blog" href="/rss.xml" />}

<!-- Open Graph — link previews in Signal, Matrix, Discord, Slack, iMessage, etc. -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Preah" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter/X reads these in preference to og: -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300..700;1,300..600&family=Source+Serif+4:opsz,wght@8..60,300..600&family=Spline+Sans+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400..600&display=swap"
  rel="stylesheet"
/>
<slot />
