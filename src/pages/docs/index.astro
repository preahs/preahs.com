---
import { getCollection } from 'astro:content';
import { formatDate, readingTime, collectTags } from '../../lib/blog';
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TagFeed from '../../components/TagFeed.astro';
import '../../styles/global.css';

const allDocs = (await getCollection('docs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const entries = allDocs.map((d) => ({
  title: d.data.title,
  desc: d.data.description,
  tags: d.data.tags,
  date: formatDate(d.data.date),
  read: readingTime(d.body ?? ''),
  href: `/docs/${d.id.replace(/\.mdx?$/, '')}`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Docs"
      description="Labs, runbooks, and reference material."
    />
  </head>
  <body>
    <div class="wrap">
      <SiteHeader active="docs" />

      <TagFeed
        entries={entries}
        tags={collectTags(allDocs)}
        intro="Labs, runbooks, and reference material. Things I write down so I can find them again, and what makes up the bulk of my time writing."
        noun="doc"
        nounPlural="docs"
      />

      <SiteFooter />
    </div>
  </body>
</html>
